// ============================================================
// Lucky Egg Launch Control — Setup New Tabs
// Adds Tasks_Template, People, and SKU_Tasks to this spreadsheet.
// Does NOT touch "Arrival Date by SKU" or its existing sync/trigger.
// Safe to re-run: each function clears and rewrites its own tab only.
// ============================================================

function setupLaunchControlTabs() {
  writePeopleTab();
  writeTasksTemplateTab();
  writeSkuTasksTab();
  SpreadsheetApp.getUi().alert('Done — People, Tasks_Template, and SKU_Tasks tabs are set up.');
}

